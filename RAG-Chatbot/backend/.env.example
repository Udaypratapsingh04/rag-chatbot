# Copy this file to ".env" (same folder) and fill in ONE of the keys.
# You can also skip this file entirely and paste the key in the app under Settings.

# Google Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which one to use when both are set: gemini or openai (Settings in the app overrides this)
LLM_PROVIDER=gemini

# Optional: pin exact model names. Leave empty and the app picks a model that works.
# GEMINI_CHAT_MODEL=
# GEMINI_EMBEDDING_MODEL=
# OPENAI_CHAT_MODEL=
# OPENAI_EMBEDDING_MODEL=
